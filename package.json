{
  "name": "podium-gui",
  "version": "1.0.0-beta.1",
  "description": "Professional GUI for Podium PHP Development Platform",
  "main": "dist/main.js",
  "scripts": {
    "build-ts": "tsc",
    "watch-ts": "tsc --watch",
    "start": "npm run build-ts && electron dist/main.js",
    "dev": "npm run build-ts && electron dist/main.js --dev",
    "build": "npm run build-ts && electron-builder",
    "build-mac": "npm run build-ts && electron-builder --mac",
    "build-win": "npm run build-ts && electron-builder --win",
    "build-linux": "npm run build-ts && electron-builder --linux",
    "pack": "npm run build-ts && electron-builder --dir",
    "dist": "npm run build-ts && electron-builder --publish=never",
    "clean": "rm -rf dist release",
    "rebuild": "npm run clean && npm run build-ts",
    "test:e2e": "npm run build-ts && node tests/e2e.js",
    "test": "npm run test:e2e",
    "dist:linux": "npm run clean && npm run build-ts && electron-builder --linux deb rpm pacman",
    "dist:mac": "npm run clean && npm run build-ts && electron-builder --mac dmg"
  },
  "keywords": [
    "php",
    "laravel",
    "wordpress",
    "docker",
    "development",
    "gui"
  ],
  "author": "Cane Bay Computers",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.11",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-to-html": "^0.7.2",
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "com.canebaycomputers.podium",
    "productName": "Podium",
    "directories": {
      "output": "release",
      "buildResources": "packaging"
    },
    "files": [
      "dist/**/*",
      "src/**/*",
      "*.html",
      "*.css",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "pacman"
      ],
      "category": "Development",
      "icon": "packaging/icons",
      "maintainer": "Cane Bay Computers <canebaycomputers@gmail.com>",
      "vendor": "Cane Bay Computers",
      "synopsis": "Desktop front end for Podium CLI",
      "description": "Podium GUI is the desktop front end for Podium CLI. Create projects with AI, install from the app library, and manage Docker-backed local development without the terminal. Requires Podium CLI, which the post-install step installs if it is missing.",
      "desktop": {
        "Name": "Podium",
        "StartupWMClass": "Podium"
      }
    },
    "deb": {
      "depends": [
        "git",
        "curl",
        "ca-certificates"
      ],
      "afterInstall": "packaging/after-install.sh"
    },
    "rpm": {
      "depends": [
        "git",
        "curl"
      ],
      "afterInstall": "packaging/after-install.sh"
    },
    "pacman": {
      "depends": [
        "docker",
        "git",
        "curl"
      ],
      "afterInstall": "packaging/after-install.sh"
    }
  },
  "private": true
}
