#!/bin/bash
set -e

# Pre-removal script for Zeltro CLI

echo "Preparing to remove Zeltro GUI..."

# Run zeltro uninstall to clean up Docker resources selectively
if [ -x /usr/local/bin/zeltro ]; then
    echo "Running Zeltro uninstall to clean up Docker resources..."
    /usr/local/bin/zeltro uninstall 2>/dev/null || true
    
    echo "Stopping any remaining Zeltro services..."
    
    # Try to stop shared services gracefully
    cd /usr/local/share/zeltro-cli 2>/dev/null || true
    if [ -f "scripts/shutdown.sh" ]; then
        bash scripts/shutdown.sh 2>/dev/null || true
    fi
fi

# Remove symlink
if [ -L /usr/local/bin/zeltro ]; then
    echo "Removing zeltro command..."
    rm -f /usr/local/bin/zeltro
fi

echo "Zeltro CLI removal preparation complete."
echo ""
echo "Note: Your project files and Docker images have been preserved."
echo "To completely remove all Zeltro data:"
echo "  - Remove project files manually from /usr/local/share/zeltro-cli/projects/"
echo "  - Remove Docker images: docker image prune"
echo ""

exit 0
